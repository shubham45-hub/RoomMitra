DATABASE_URL=postgresql+psycopg://roommitra:change-me@localhost:5432/roommitra
# Optional: Neon direct/unpooled URL is used only by Alembic migrations.
DATABASE_URL_UNPOOLED=
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
UPLOAD_DIR=uploads
# Neon Object Storage (optional locally; bucket is declared in the root neon.ts).
NEON_STORAGE_BUCKET=assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
JWT_SECRET_KEY=generate-a-different-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_HMAC_SECRET=generate-another-random-secret-of-at-least-32-characters
PASSWORD_RESET_CODE_TTL_SECONDS=300
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUESTS_PER_HOUR=5
SMS_PROVIDER=local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
PASSWORD_RESET_SMS_TEMPLATE=Your RoomMitra password reset code is {code}. It expires in {minutes} minutes.
MODERATOR_PHONES=

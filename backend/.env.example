DATABASE_URL=postgresql+psycopg://roommitra:change-me@localhost:5432/roommitra
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
UPLOAD_DIR=uploads
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
OTP_HMAC_SECRET=generate-a-random-secret-of-at-least-32-characters
JWT_SECRET_KEY=generate-a-different-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=5
SMS_PROVIDER=local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
OTP_SMS_TEMPLATE=Your RoomMitra login code is {code}. It expires in {minutes} minutes.
MODERATOR_PHONES=

# From the repository root, copy this to .env.production on the deployment server.
# Never commit the real .env.production file or share it in chat/screenshots.
ROOMMITRA_DOMAIN=roommitra.example.com
ROOMMITRA_API_DOMAIN=api.roommitra.example.com
VITE_API_BASE_URL=https://api.roommitra.example.com

POSTGRES_DB=roommitra
POSTGRES_USER=roommitra
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://roommitra:URL_ENCODED_PASSWORD@postgres:5432/roommitra

APP_ENV=production
CORS_ORIGINS=https://roommitra.example.com
ALLOWED_HOSTS=api.roommitra.example.com
UPLOAD_DIR=/var/lib/roommitra/uploads

# Generate a random value at least 32 characters long.
JWT_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
PASSWORD_RESET_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_CODE_TTL_SECONDS=300
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUESTS_PER_HOUR=5

# SMS is used only for password recovery, not for sign-in.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
PASSWORD_RESET_SMS_TEMPLATE=Your RoomMitra password reset code is {code}. It expires in {minutes} minutes.

# Set the owner's phone number in E.164 format to enable report moderation.
MODERATOR_PHONES=
